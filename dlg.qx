hostname = ios-api-*.duolingo.*,api*.duolingo.*,excess.duolingo.cn


^https?:\/\/(?:ios-api-[^.]+|api[^.]+|excess)\.duolingo\.[a-z.]+\/.*\/batch url script-response-body https://raw.githubusercontent.com/sbc2fjbdn5-prog/dlg/main/duolingo_batch.js


^https?:\/\/(?:ios-api-[^.]+|api[^.]+|excess)\.duolingo\.[a-z.]+\/.*\/users\/.*\/available-features.*$ url script-response-body https://raw.githubusercontent.com/sbc2fjbdn5-prog/dlg/main/duolingo_features.js


^https?:\/\/(?:ios-api-[^.]+|api[^.]+|excess)\.duolingo\.[a-z.]+\/.*\/users\/.*\?fields=subscriberLevel url script-response-body https://raw.githubusercontent.com/sbc2fjbdn5-prog/dlg/main/duolingo_level.js